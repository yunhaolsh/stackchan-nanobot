# Copy this file to .run/stackchan-nanobot.env and fill only local values.
# Never commit the filled file.

STACKCHAN_PUBLIC_HOST=stackchan-nanobot.local
# Set this on WSL or multi-NIC hosts when automatic route detection picks the wrong interface.
# STACKCHAN_MDNS_ADDRESS=192.168.137.247
STACKCHAN_RESTART_BRIDGE=1
STACKCHAN_ENABLE_NANOBOT_API=0
# Change this value to start a clean conversation without deleting old history.
STACKCHAN_SESSION_NAMESPACE=stackchan-phase1-v4
# Ordinary device RPCs are expected to finish quickly. Camera capture includes
# JPEG upload plus cloud vision and therefore has its own longer timeout.
STACKCHAN_MCP_RPC_TIMEOUT=20
STACKCHAN_CAMERA_MCP_TIMEOUT=120
# Only these Nanobot built-ins may accompany the policy-approved device tools.
STACKCHAN_SAFE_NANOBOT_TOOLS=web_search,web_fetch

# Domestic Zhipu AI. One key is used by Chat, ASR, TTS, and Vision by default.
# ZHIPU_API_KEY=
STACKCHAN_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# Set to 1 only when a local HTTP proxy makes domestic provider calls slow or unreliable.
STACKCHAN_BYPASS_PROVIDER_PROXY=0
STACKCHAN_CHAT_TIMEOUT=45
STACKCHAN_CHAT_MAX_RETRIES=0
STACKCHAN_GLM_MAX_RETRIES=2
STACKCHAN_GLM_RETRY_BACKOFF=1
STACKCHAN_CHAT_PROVIDER=glm
STACKCHAN_CHAT_MODEL=glm-4.7-flash
STACKCHAN_CHAT_THINKING=disabled

STACKCHAN_ASR_PROVIDER=glm
STACKCHAN_ASR_MODEL=glm-asr-2512
# GLM defines prompt as previous-transcript context, not an instruction.
STACKCHAN_ASR_PROMPT=
# JSON array accepted by GLM-ASR's domain vocabulary parameter.
STACKCHAN_ASR_HOTWORDS='["StackChan","倒计时","计时器","十秒","灯光","红色","紫色","转头","音量","亮度"]'
# Optional local-only WAV captures for microphone diagnosis.
# STACKCHAN_ASR_DEBUG_DIR=/path/to/stackchan/.run/asr-debug

STACKCHAN_TTS_PROVIDER=glm
STACKCHAN_TTS_MODEL=glm-tts
STACKCHAN_TTS_VOICE=tongtong
# Pace 60 ms Opus packets in real time; the ESP32 decode queue holds only 2400 ms.
STACKCHAN_TTS_PACKET_INTERVAL_MS=60
STACKCHAN_TTS_STOP_GRACE_MS=120
# Abort a provider subprocess that produces no first packet or stalls mid-stream.
STACKCHAN_TTS_FIRST_PACKET_TIMEOUT=15
STACKCHAN_TTS_STREAM_IDLE_TIMEOUT=15
# Keep each spoken subtitle within the StackChan three-line speech bubble.
STACKCHAN_TTS_SEGMENT_MAX_CHARS=42

STACKCHAN_VISION_PROVIDER=glm
STACKCHAN_VISION_MODEL=glm-4.6v-flash
# Recover a completed analysis if device HTTP completion races with a new wake event.
STACKCHAN_VISION_RESULT_TTL=120

# Server-side endpointing for the firmware's auto listening mode.
STACKCHAN_VAD_AGGRESSIVENESS=3
STACKCHAN_VAD_MIN_SPEECH_MS=300
STACKCHAN_VAD_END_SILENCE_MS=600
STACKCHAN_VAD_NO_SPEECH_TIMEOUT_MS=5000
STACKCHAN_VAD_MAX_DURATION_MS=8000
STACKCHAN_VAD_PRE_ROLL_MS=240
STACKCHAN_VAD_POST_ROLL_MS=300

# Optional Chat-only switch. GLM remains the default ASR/TTS provider.
# STACKCHAN_CHAT_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# STACKCHAN_CHAT_MODEL=deepseek-v4-flash

# Optional local OpenAI-compatible LLM, for example llama-server.
# STACKCHAN_CHAT_PROVIDER=openai-compatible
# OPENAI_API_KEY=local-no-secret
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# STACKCHAN_CHAT_MODEL=Qwen3-4B

# Optional local ASR/TTS adapters. These commands use the same stdin/file
# contracts as the provider scripts under scripts/.
# STACKCHAN_ASR_PROVIDER=local
# STACKCHAN_ASR_COMMAND=/absolute/path/to/local_asr_adapter
# STACKCHAN_TTS_PROVIDER=local
# STACKCHAN_TTS_COMMAND=/absolute/path/to/local_tts_adapter

# Optional provider-specific Chat key override.
# STACKCHAN_CHAT_API_KEY=
